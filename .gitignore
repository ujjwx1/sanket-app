# Keep private files out by default; explicitly allow application files only.
/*
!/.gitignore
!/README.md
!/readme-assets/
/readme-assets/*
!/readme-assets/sanket-logo.png
!/readme-assets/report-screen.png
!/readme-assets/report-mobile.png
!/app.py
!/requirements.txt
!/app.js
!/index.html
!/style.css
!/test_app.py
!/react-ui/
/react-ui/*
!/react-ui/.gitignore
!/react-ui/.oxlintrc.json
!/react-ui/components.json
!/react-ui/index.html
!/react-ui/jsconfig.json
!/react-ui/package.json
!/react-ui/package-lock.json
!/react-ui/vite.config.js
!/react-ui/src/
/react-ui/src/*
!/react-ui/src/*.js
!/react-ui/src/*.jsx
!/react-ui/src/*.css
!/react-ui/src/lib/
/react-ui/src/lib/*
!/react-ui/src/lib/*.js
!/react-ui/src/components/
/react-ui/src/components/*
!/react-ui/src/components/ui/
/react-ui/src/components/ui/*
!/react-ui/src/components/ui/*.jsx
